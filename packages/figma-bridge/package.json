{
  "name": "@aster-ui/figma-bridge",
  "version": "3.1.0-beta.2",
  "description": "Fail-closed Figma Variables REST adapter and human-review contract for Aster UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwakhyun/aster-ui-platform.git",
    "directory": "packages/figma-bridge"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aster-ui/tokens": "workspace:*"
  }
}
