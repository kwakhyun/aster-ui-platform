{
  "name": "@aster-ui/react",
  "version": "3.1.0-beta.2",
  "description": "Accessible React components with generated public API contracts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwakhyun/aster-ui-platform.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest": "./dist/component-manifest.json"
  },
  "scripts": {
    "build": "node ../../scripts/generate-component-manifest.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@aster-ui/tokens": "workspace:*",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
